---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found" noindex>
  <section class="wrap flex min-h-[60vh] flex-col items-start justify-center py-24">
    <p class="cat">Error 404</p>
    <h1 class="display mt-4 text-5xl md:text-7xl">This page could not be found.</h1>
    <p class="lead mt-5">The link may be broken, or the page may have moved.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="btn btn-primary" href="/">Go home</a>
      <a class="btn btn-ghost" href="/articles/">Browse articles</a>
    </div>
  </section>
</Layout>
