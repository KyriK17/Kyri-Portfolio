---
import Layout from '../layouts/Layout.astro';
import SocialPosts from '../components/SocialPosts.astro';
import SocialViewer from '../components/SocialViewer.astro';
import SocialLinks from '../components/SocialLinks.astro';
import EmptyState from '../components/EmptyState.astro';
import { getSocialPosts } from '../lib/social';
import { pageText, site, socials } from '../lib/site';

const reels = await getSocialPosts('instagram');
const linkedin = await getSocialPosts('linkedin');
const hasAnything = reels.length > 0 || linkedin.length > 0 || socials.length > 0 || Boolean(site.email);
---

<Layout title="Socials" description="Latest reels and posts, and where to follow along.">
  <section class="wrap pt-14 pb-24 md:pt-20 md:pb-32">
    <h1 class="display page-title text-5xl md:text-7xl">Socials</h1>
    <p class="lead mt-5">The latest reels and posts, and the best ways to get in touch.</p>

    {!hasAnything && (
      <div class="mt-12">
        <EmptyState title="Coming soon." />
      </div>
    )}

    {reels.length > 0 && (
      <div class="social-block mt-16">
        <SocialPosts platform="instagram" title="Instagram" id="reels-title" bare />
      </div>
    )}

    {linkedin.length > 0 && (
      <div class="social-block mt-16">
        <SocialPosts platform="linkedin" title="LinkedIn" id="linkedin-title" bare />
      </div>
    )}

    {(socials.length > 0 || site.email) && (
      <div class="mt-16 border-t border-line pt-12" id="contact">
        <h2 class="font-serif text-2xl">Get in touch</h2>
        {pageText.contactIntro && <p class="lead mt-4">{pageText.contactIntro}</p>}
        {site.email && (
          <p class="mt-8">
            <a class="email-link" href={`mailto:${site.email}`}>{site.email}</a>
          </p>
        )}
        {socials.length > 0 && <SocialLinks class="mt-8" showLabels />}
      </div>
    )}
  </section>
  <SocialViewer />
</Layout>
