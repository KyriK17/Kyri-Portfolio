---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getArticles, getProjects, slugify, formatDate } from '../lib/utils';
import { home, seo, site, socials } from '../lib/site';

// ---- Articles: latest, or only those marked "featured" (chosen in Homepage settings) ----
const allArticles = await getArticles();
const featuredArticles = allArticles.filter((a) => a.data.featured);
const pool =
  home.articlesMode === 'featured' && featuredArticles.length > 0 ? featuredArticles : allArticles;

// The first story is shown large in the hero; the others go in the list below it.
const leadStory = pool[0];
const latest = pool.slice(1, 4);

// ---- Projects: those marked "featured", or all of them if none are marked ----
const allProjects = await getProjects();
const featuredProjects = allProjects.filter((p) => p.data.featured);
const projects = (featuredProjects.length > 0 ? featuredProjects : allProjects).slice(0, 3);

// ---- About ----
const about = await getEntry('about', 'about');
const aboutSummary = home.aboutSummary || about?.data.summary || '';
const aboutImage = about?.data.profileImage || '';
const aboutImageAlt = about?.data.profileImageAlt || '';

// ---- Media / Business / Sport: equal entries, counted from the existing content ----
const desks = [
  { name: 'Media', slugs: ['media'] },
  { name: 'Business', slugs: ['business'] },
  { name: 'Sport', slugs: ['sport', 'sports'] },
].map((desk) => {
  const articles = allArticles.filter((a) => desk.slugs.includes(slugify(a.data.category)));
  const projectCount = allProjects.filter((p) => desk.slugs.includes(slugify(p.data.category))).length;
  const parts = [
    articles.length ? `${articles.length} ${articles.length === 1 ? 'article' : 'articles'}` : '',
    projectCount ? `${projectCount} ${projectCount === 1 ? 'project' : 'projects'}` : '',
  ].filter(Boolean);
  const href = articles.length
    ? `/articles/category/${slugify(articles[0].data.category)}/`
    : projectCount
      ? '/projects/'
      : '';
  return { name: desk.name, href, meta: parts.join(', ') || 'Nothing filed yet' };
});

// ---- Which sections have something to show? Empty ones are hidden. ----
const show = {
  about: home.showAbout && Boolean(aboutSummary || aboutImage),
  articles: home.showArticles && latest.length > 0,
  projects: home.showProjects && projects.length > 0,
  contact: home.showContact && Boolean(site.email || socials.length > 0 || home.contactText),
};

const hasHeroText = Boolean(site.tagline || home.heroIntro);
const showHeroButtons = allArticles.length > 0 || allProjects.length > 0;

const title = seo.homeTitle || (site.name ? `${site.name} – Writing and Journalism Portfolio` : 'Home');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  ...(site.name ? { name: site.name } : {}),
  url: Astro.site?.href,
  ...((seo.homeDescription || site.description) ? { description: seo.homeDescription || site.description } : {}),
};
---

<Layout title={title} description={seo.homeDescription || undefined} jsonLd={jsonLd}>
  <!-- HERO -->
  <section class="hero2" aria-labelledby="hero-title">
    <div class="wrap hero2-grid">
      <div>
        {
          site.name ? (
            <h1 id="hero-title" class="wordmark-mask">
              <span class="wordmark">{site.name}</span>
            </h1>
          ) : (
            <h1 id="hero-title" class="sr-only">Home</h1>
          )
        }
        {site.tagline && <p class="hero2-tagline">{site.tagline}</p>}
        {home.heroIntro && <p class="hero2-intro">{home.heroIntro}</p>}
        {
          showHeroButtons && (
            <div class="hero-actions">
              {allArticles.length > 0 && (
                <a class="btn btn-primary" href="/articles/">View articles</a>
              )}
              {allProjects.length > 0 && (
                <a class:list={['btn', allArticles.length > 0 ? 'btn-ghost' : 'btn-primary']} href="/projects/">View projects</a>
              )}
            </div>
          )
        }
      </div>

      {
        leadStory && (
          <a class="lead-story" href={`/articles/${leadStory.id}/`}>
            {leadStory.data.image && (
              <div class="lead-media">
                <img
                  src={leadStory.data.image}
                  alt={leadStory.data.imageAlt}
                  width="1200"
                  height="900"
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                />
              </div>
            )}
            <div class="lead-caption">
              <p class="meta">
                <span class="cat">{leadStory.data.category}</span>
                <time datetime={leadStory.data.date.toISOString()}>{formatDate(leadStory.data.date)}</time>
              </p>
              <h2 class="lead-title">{leadStory.data.title}</h2>
            </div>
          </a>
        )
      }
    </div>
  </section>

  <!-- MEDIA / BUSINESS / SPORT -->
  <section class="desks" aria-label="Media, Business and Sport">
    <ul class="wrap desks-list">
      {
        desks.map((desk) => (
          <li>
            {desk.href ? (
              <a class="desk" href={desk.href}>
                <span class="desk-name">{desk.name}</span>
                <span class="desk-meta">{desk.meta}</span>
              </a>
            ) : (
              <div class="desk is-empty">
                <span class="desk-name">{desk.name}</span>
                <span class="desk-meta">{desk.meta}</span>
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ABOUT -->
  {
    show.about && (
      <section class="section" aria-labelledby="about-title">
        <div class="wrap">
          <SectionHeading title="About" id="about-title" />
          <div class="grid items-start gap-12 lg:grid-cols-12 lg:gap-16">
            <div class:list={[aboutImage ? 'lg:col-span-7' : 'lg:col-span-10']}>
              {aboutSummary && <p class="statement">{aboutSummary}</p>}
              <a class:list={['btn btn-ghost', aboutSummary && 'mt-10']} href="/about/">Read the full About page</a>
            </div>
            {aboutImage && (
              <div class="max-w-sm lg:col-span-5 lg:max-w-none">
                <img
                  class="portrait"
                  src={aboutImage}
                  alt={aboutImageAlt}
                  width="800"
                  height="1000"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  <!-- ARTICLES -->
  {
    show.articles && (
      <section class="section pt-0" aria-labelledby="articles-title">
        <div class="wrap">
          <SectionHeading
            title={home.articlesMode === 'featured' && featuredArticles.length > 0 ? 'More featured articles' : 'More articles'}
            id="articles-title"
            href="/articles/"
            linkLabel="All articles"
          />
          <div class="card-grid">
            {latest.map((article) => (
              <ArticleCard article={article} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- PROJECTS -->
  {
    show.projects && (
      <section class="section pt-0" aria-labelledby="projects-title">
        <div class="wrap">
          <SectionHeading
            title="Featured projects"
            id="projects-title"
            href="/projects/"
            linkLabel="All projects"
          />
          <div class="card-grid">
            {projects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- CONTACT -->
  {
    show.contact && (
      <section class="section pt-0" aria-labelledby="contact-title">
        <div class="wrap">
          <SectionHeading title="Contact" id="contact-title" />
          {home.contactText && <p class="statement max-w-3xl">{home.contactText}</p>}
          {site.email && (
            <p class:list={[home.contactText && 'mt-8']}>
              <a class="email-link" href={`mailto:${site.email}`}>{site.email}</a>
            </p>
          )}
          {socials.length > 0 && <SocialLinks class:list={[(site.email || home.contactText) && 'mt-10']} showLabels />}
        </div>
      </section>
    )
  }
</Layout>
