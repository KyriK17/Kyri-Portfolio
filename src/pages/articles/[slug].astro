---
import WebImage from '../../components/WebImage.astro';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ShareArticle from '../../components/ShareArticle.astro';
import { getArticles, getRelated, formatDate, readingTime, slugify } from '../../lib/utils';
import { site } from '../../lib/site';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const {
  title,
  subtitle,
  author,
  date,
  category,
  tags,
  image,
  imageAlt,
  excerpt,
  seoTitle,
  seoDescription,
} = article.data;

const minutes = readingTime(article.body);
const related = getRelated(article, await getArticles(), 3);

const shareImage = image || '/uploads/Crimson Glow Monogram K.png';
const articleUrl = new URL(Astro.url.pathname, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: seoDescription || excerpt || undefined,
  image: [new URL(shareImage, Astro.site).href],
  datePublished: date.toISOString(),
  ...(author ? { author: { '@type': 'Person', name: author } } : {}),
  ...(site.name ? { publisher: { '@type': 'Organization', name: site.name } } : {}),
  mainEntityOfPage: articleUrl,
};
---

<Layout
  title={seoTitle || title}
  description={seoDescription || excerpt || undefined}
  image={shareImage}
  type="article"
  publishedTime={date.toISOString()}
  jsonLd={jsonLd}
>
  <div class="read-progress" aria-hidden="true"></div>
  <article>
    <header class="wrap pt-12 md:pt-20">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <a
          class="cat link-line"
          href={`/articles/category/${slugify(category)}/`}
        >
          {category}
        </a>

        <ShareArticle
          title={title}
          url={articleUrl}
          description={seoDescription || excerpt || ''}
          image={shareImage}
        />
      </div>

      <h1 class="article-title mt-5">{title}</h1>

      {subtitle && <p class="article-sub mt-6">{subtitle}</p>}

      <dl class="byline mt-10">
        {
          author && (
            <div>
              <dt>Words by</dt>
              <dd>{author}</dd>
            </div>
          )
        }

        <div>
          <dt>Published</dt>
          <dd>
            <time datetime={date.toISOString()}>{formatDate(date)}</time>
          </dd>
        </div>

        <div>
          <dt>Reading time</dt>
          <dd>{minutes} min read</dd>
        </div>
      </dl>
    </header>

    {
      image && (
        <figure class="wrap article-figure mt-10 md:mt-14">
          <WebImage
            src={image}
            alt={imageAlt}
            width={1200}
            height={800}
            sizes="(min-width: 1200px) 1100px, 100vw"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      )
    }

    <div class="wrap mt-12 md:mt-16">
      <div class="prose-editorial dropcap">
        <Content />
      </div>

      {
        tags.length > 0 && (
          <div class="mx-auto mt-14 max-w-[41rem] border-t border-line pt-6">
            <p class="mb-3 text-sm text-mute">Tagged</p>

            <ul class="chips">
              {tags.map((tag) => (
                <li>
                  <a class="chip" href={`/articles/tag/${slugify(tag)}/`}>
                    {tag}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <div class="mx-auto mt-16 max-w-[41rem] border-y border-line py-6">
        <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="text-xs uppercase tracking-[0.14em] text-mute">
              Share this article
            </p>
            <p class="mt-1 text-sm text-mute">
              Send this story to your contacts or share it elsewhere.
            </p>
          </div>

          <ShareArticle
            title={title}
            url={articleUrl}
            description={seoDescription || excerpt || ''}
            image={shareImage}
          />
        </div>
      </div>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="section" aria-labelledby="related-title">
        <div class="wrap">
          <SectionHeading
            id="related-title"
            title="Related articles"
            href="/articles/"
            linkLabel="All articles"
          />

          <div class="card-grid">
            {related.map((item) => (
              <ArticleCard article={item} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Layout>

<script>
  // Reading progress: a thin red line across the top that fills as you read.
  const bar = document.querySelector<HTMLElement>('.read-progress');
  if (bar) {
    const update = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      bar.style.transform = `scaleX(${max > 0 ? Math.min(1, window.scrollY / max) : 0})`;
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }
</script>
