---
import { socials } from '../lib/site';

interface Props {
  /** Show the network name next to each icon. */
  showLabels?: boolean;
  class?: string;
}

const { showLabels = false, class: className = '' } = Astro.props;
const svgProps = {
  width: 20,
  height: 20,
  viewBox: '0 0 24 24',
  'aria-hidden': 'true',
  focusable: 'false',
};
---

{
  socials.length > 0 && (
    <ul class:list={['socials', className]}>
      {socials.map((s) => (
        <li>
          <a class="social" href={s.url} target="_blank" rel="noopener noreferrer">
            {s.key === 'instagram' && (
              <svg {...svgProps} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.5" cy="6.5" r="0.6" />
              </svg>
            )}
            {s.key === 'linkedin' && (
              <svg {...svgProps} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                <rect x="2" y="9" width="4" height="12" />
                <circle cx="4" cy="4" r="2" />
              </svg>
            )}
            {s.key === 'x' && (
              <svg {...svgProps} fill="currentColor">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
              </svg>
            )}
            {s.key === 'github' && (
              <svg {...svgProps} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                <path d="M9 18c-4.51 2-5-2-7-2" />
              </svg>
            )}
            <span class:list={[!showLabels && 'sr-only']}>{s.label}</span>
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        </li>
      ))}
    </ul>
  )
}
