---
interface Props {
  title: string;
  url: string;
  description?: string;
  image?: string;
  compact?: boolean;
}

const {
  title,
  url,
  compact = false,
} = Astro.props;
---

<div
  class:list={['share-wrap', compact && 'share-compact']}
  data-title={title}
  data-url={url}
>
  <button
    class="share-trigger"
    type="button"
    aria-label={`Share ${title}`}
  >
    <span>Share</span>
    <span class="share-icon" aria-hidden="true">↗</span>
  </button>
</div>

<script>
  document.querySelectorAll('.share-wrap').forEach((element) => {
    const root = element as HTMLElement;

    if (root.dataset.shareInitialised === 'true') return;
    root.dataset.shareInitialised = 'true';

    const button = root.querySelector(
      '.share-trigger'
    ) as HTMLButtonElement | null;

    if (!button) return;

    const title = root.dataset.title || document.title;

    const pageUrl = new URL(
      root.dataset.url || window.location.href,
      window.location.href
    ).href;

    button.addEventListener('click', async () => {
      if (typeof navigator.share !== 'function') {
        /*
         * There is no browser API capable of opening the device
         * Sharesheet when Web Share is unavailable.
         *
         * Do not substitute a hard-coded list of social platforms.
         */
        console.warn(
          'Web Share API is unavailable in this browser/context.'
        );
        return;
      }

      try {
        await navigator.share({
          title,
          text: title,
          url: pageUrl,
        });
      } catch (error) {
        /*
         * Cancelling the native share chooser is normal.
         */
        if (
          error instanceof DOMException &&
          error.name === 'AbortError'
        ) {
          return;
        }

        console.error('Native sharing failed:', error);
      }
    });
  });
</script>

<style>
  .share-wrap {
    display: inline-flex;
    align-items: center;
  }

  .share-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.4rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid #292929;
    background: #111111;
    color: #f4f0e9;
    font: inherit;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .share-trigger:hover {
    background: #a71930;
    border-color: #a71930;
    color: #ffffff;
    transform: translateY(-1px);
  }

  .share-trigger:focus-visible {
    outline: 2px solid #a71930;
    outline-offset: 3px;
  }

  .share-icon {
    font-size: 0.9rem;
    line-height: 1;
  }

  .share-compact .share-trigger {
    min-height: 2.15rem;
    padding: 0.45rem 0.75rem;
  }
</style>

