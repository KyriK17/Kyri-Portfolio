---
interface Props {
  title: string;
  url: string;
  description?: string;
  image?: string;
  compact?: boolean;
}

const {
  title,
  url,
  description = '',
  image = '/uploads/Crimson Glow Monogram K.png',
  compact = false,
} = Astro.props;

const absoluteImage = new URL(image, Astro.site).href;
---

<div
  class:list={['share-wrap', compact && 'share-compact']}
  data-share-title={title}
  data-share-url={url}
  data-share-description={description}
  data-share-image={absoluteImage}
>
  <button class="share-trigger" type="button" aria-expanded="false">
    <span>Share</span>
    <span class="share-icon">↗</span>
  </button>

  <div class="share-panel" hidden>
    <div class="share-heading">SHARE ARTICLE</div>

    <div class="share-preview">
      <img src={image} alt="" loading="lazy" />

      <div class="share-preview-copy">
        <strong>{title}</strong>
        {description && <p>{description}</p>}
      </div>
    </div>

    <div class="share-actions">
      <a
        class="share-btn"
        data-share="x"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
      >
        X
      </a>

      <a
        class="share-btn"
        data-share="facebook"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
      >
        Facebook
      </a>

      <a
        class="share-btn"
        data-share="linkedin"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
      >
        LinkedIn
      </a>

      <a
        class="share-btn"
        data-share="whatsapp"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
      >
        WhatsApp
      </a>

      <button class="share-btn" data-share="instagram" type="button">
        Instagram
      </button>

      <button class="share-btn share-native" data-share="native" type="button">
        Share
      </button>

      <button class="share-btn" data-share="copy" type="button">
        Copy link
      </button>
    </div>

    <div class="instagram-panel" hidden>
      <div class="instagram-heading">INSTAGRAM</div>

      <a
        class="instagram-option"
        href="https://www.instagram.com/stories/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="instagram-option-icon">▣</span>

        <span>
          <strong>Instagram Story</strong>
          <small>Open Instagram Stories</small>
        </span>
      </a>

      <a
        class="instagram-option"
        href="https://www.instagram.com/direct/inbox/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="instagram-option-icon">✉</span>

        <span>
          <strong>Direct message</strong>
          <small>Open Instagram messages</small>
        </span>
      </a>

      <button class="instagram-option" data-instagram="copy" type="button">
        <span class="instagram-option-icon">↗</span>

        <span>
          <strong>Copy link</strong>
          <small>Paste the article into Instagram</small>
        </span>
      </button>

      <a
        class="instagram-option"
        href="https://www.instagram.com/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="instagram-option-icon">◎</span>

        <span>
          <strong>Instagram</strong>
          <small>Open Instagram</small>
        </span>
      </a>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('.share-wrap').forEach((share) => {
    const root = share as HTMLElement;

    const trigger = root.querySelector('.share-trigger') as HTMLButtonElement | null;
    const panel = root.querySelector('.share-panel') as HTMLElement | null;

    const instagramButton = root.querySelector(
      '[data-share="instagram"]'
    ) as HTMLButtonElement | null;

    const instagramPanel = root.querySelector(
      '.instagram-panel'
    ) as HTMLElement | null;

    if (!trigger || !panel) return;

    const title = root.dataset.shareTitle || '';
    const url = root.dataset.shareUrl || window.location.href;
    const description = root.dataset.shareDescription || '';

    const encodedTitle = encodeURIComponent(title);
    const encodedUrl = encodeURIComponent(url);
    const encodedText = encodeURIComponent(`${title} ${url}`);

    const x = root.querySelector('[data-share="x"]') as HTMLAnchorElement | null;
    const facebook = root.querySelector(
      '[data-share="facebook"]'
    ) as HTMLAnchorElement | null;
    const linkedin = root.querySelector(
      '[data-share="linkedin"]'
    ) as HTMLAnchorElement | null;
    const whatsapp = root.querySelector(
      '[data-share="whatsapp"]'
    ) as HTMLAnchorElement | null;

    if (x) {
      x.href = `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`;
    }

    if (facebook) {
      facebook.href = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
    }

    if (linkedin) {
      linkedin.href =
        `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
    }

    if (whatsapp) {
      whatsapp.href = `https://wa.me/?text=${encodedText}`;
    }

    trigger.addEventListener('click', () => {
      const isOpen = !panel.hidden;

      panel.hidden = isOpen;

      if (isOpen && instagramPanel) {
        instagramPanel.hidden = true;
      }

      trigger.setAttribute('aria-expanded', String(!isOpen));
    });

    instagramButton?.addEventListener('click', () => {
      if (!instagramPanel) return;

      instagramPanel.hidden = !instagramPanel.hidden;
    });

    root
      .querySelector('[data-share="copy"]')
      ?.addEventListener('click', async (event) => {
        const button = event.currentTarget as HTMLButtonElement;

        try {
          await navigator.clipboard.writeText(url);

          const original = button.textContent;

          button.textContent = 'Copied ✓';

          setTimeout(() => {
            button.textContent = original || 'Copy link';
          }, 1800);
        } catch {
          window.prompt('Copy this link:', url);
        }
      });

    root
      .querySelector('[data-share="native"]')
      ?.addEventListener('click', async (event) => {
        const button = event.currentTarget as HTMLButtonElement;

        if (!navigator.share) {
          try {
            await navigator.clipboard.writeText(url);

            button.textContent = 'Link copied ✓';

            setTimeout(() => {
              button.textContent = 'Share';
            }, 1800);
          } catch {}

          return;
        }

        try {
          await navigator.share({
            title,
            text: description || title,
            url,
          });
        } catch {}
      });

    root
      .querySelector('[data-instagram="copy"]')
      ?.addEventListener('click', async (event) => {
        const button = event.currentTarget as HTMLButtonElement;

        try {
          await navigator.clipboard.writeText(url);

          const strong = button.querySelector('strong');

          if (strong) {
            strong.textContent = 'Link copied ✓';

            setTimeout(() => {
              strong.textContent = 'Copy link';
            }, 1800);
          }
        } catch {}
      });

    document.addEventListener('click', (event) => {
      if (!root.contains(event.target as Node)) {
        panel.hidden = true;

        if (instagramPanel) {
          instagramPanel.hidden = true;
        }

        trigger.setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>

<style>
  .share-wrap {
    position: relative;
    display: inline-block;
    z-index: 20;
  }

  .share-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid #292929;
    background: #111111;
    color: #f4f0e9;
    padding: 0.55rem 0.85rem;
    font: inherit;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .share-trigger:hover,
  .share-trigger[aria-expanded='true'] {
    background: #a71930;
    border-color: #a71930;
    color: #ffffff;
  }

  .share-icon {
    font-size: 0.9rem;
    line-height: 1;
  }

  .share-panel {
    position: absolute;
    z-index: 100;
    top: calc(100% + 0.65rem);
    right: 0;
    width: min(25rem, calc(100vw - 2rem));
    padding: 1rem;
    background: #101010;
    color: #f4f0e9;
    border: 1px solid #a71930;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.35);
  }

  .share-heading,
  .instagram-heading {
    margin-bottom: 0.8rem;
    color: #c32640;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .share-preview {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 0.85rem;
    padding-bottom: 1rem;
    margin-bottom: 0.9rem;
    border-bottom: 1px solid #2d2d2d;
  }

  .share-preview img {
    width: 5rem;
    height: 5rem;
    object-fit: cover;
    border: 1px solid #333333;
  }

  .share-preview-copy {
    min-width: 0;
  }

  .share-preview strong {
    display: block;
    color: #ffffff;
    font-family: Georgia, serif;
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .share-preview p {
    margin: 0.35rem 0 0;
    color: #a9a5a0;
    font-size: 0.72rem;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .share-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2rem;
    border: 1px solid #343434;
    background: #171717;
    color: #e9e5df;
    padding: 0.4rem 0.65rem;
    font: inherit;
    font-size: 0.7rem;
    text-decoration: none;
    cursor: pointer;
    transition:
      background 0.18s ease,
      border-color 0.18s ease,
      color 0.18s ease;
  }

  .share-btn:hover {
    background: #a71930;
    border-color: #a71930;
    color: #ffffff;
  }

  .share-native {
    border-color: #a71930;
  }

  .instagram-panel {
    margin-top: 0.9rem;
    padding-top: 0.9rem;
    border-top: 1px solid #2d2d2d;
  }

  .instagram-option {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem;
    margin-top: 0.4rem;
    border: 1px solid #292929;
    background: #171717;
    color: #f4f0e9;
    text-decoration: none;
    text-align: left;
    cursor: pointer;
    transition:
      background 0.18s ease,
      border-color 0.18s ease;
  }

  .instagram-option:hover {
    background: #a71930;
    border-color: #a71930;
  }

  .instagram-option-icon {
    width: 1.8rem;
    height: 1.8rem;
    display: grid;
    place-items: center;
    border: 1px solid #444444;
    flex-shrink: 0;
  }

  .instagram-option strong,
  .instagram-option small {
    display: block;
  }

  .instagram-option strong {
    font-size: 0.75rem;
  }

  .instagram-option small {
    margin-top: 0.15rem;
    color: #aaaaaa;
    font-size: 0.65rem;
  }

  .instagram-option:hover small {
    color: #eeeeee;
  }

  .share-compact .share-panel {
    right: auto;
    left: 0;
  }

  @media (max-width: 640px) {
    .share-panel {
      position: fixed;
      left: 1rem;
      right: 1rem;
      bottom: 1rem;
      top: auto;
      width: auto;
    }

    .share-compact .share-panel {
      left: 1rem;
      right: 1rem;
    }
  }
</style>
