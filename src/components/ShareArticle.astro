---
interface Props {
  title: string;
  url: string;
  description?: string;
  image?: string;
  compact?: boolean;
}

const {
  title,
  url,
  description = '',
  image = '/uploads/Crimson Glow Monogram K.png',
  compact = false,
} = Astro.props;

const absoluteImage = new URL(image, Astro.site).href;
---

<div
  class:list={['share-wrap', compact && 'share-compact']}
  data-share-title={title}
  data-share-url={url}
  data-share-description={description}
  data-share-image={absoluteImage}
>
  <button class="share-trigger" type="button" aria-expanded="false">
    <span>Share</span>
  </button>

  <div class="share-panel" hidden>
    <div class="share-preview">
      <img src={image} alt="" loading="lazy" />
      <div>
        <strong>{title}</strong>
        {description && <p>{description}</p>}
      </div>
    </div>

    <div class="share-actions">
      <a class="share-btn" data-share="x" href="#" target="_blank" rel="noopener noreferrer">X</a>
      <a class="share-btn" data-share="facebook" href="#" target="_blank" rel="noopener noreferrer">Facebook</a>
      <a class="share-btn" data-share="linkedin" href="#" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a class="share-btn" data-share="whatsapp" href="#" target="_blank" rel="noopener noreferrer">WhatsApp</a>
      <button class="share-btn" data-share="instagram" type="button">Instagram</button>
      <button class="share-btn" data-share="native" type="button">Share</button>
      <button class="share-btn" data-share="copy" type="button">Copy link</button>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('.share-wrap').forEach((share) => {
    const root = share as HTMLElement;
    const trigger = root.querySelector('.share-trigger') as HTMLButtonElement | null;
    const panel = root.querySelector('.share-panel') as HTMLElement | null;

    if (!trigger || !panel) return;

    const title = root.dataset.shareTitle || '';
    const url = root.dataset.shareUrl || window.location.href;
    const description = root.dataset.shareDescription || '';

    const encodedTitle = encodeURIComponent(title);
    const encodedUrl = encodeURIComponent(url);
    const encodedText = encodeURIComponent(`${title} ${url}`);

    const x = root.querySelector('[data-share="x"]') as HTMLAnchorElement | null;
    const facebook = root.querySelector('[data-share="facebook"]') as HTMLAnchorElement | null;
    const linkedin = root.querySelector('[data-share="linkedin"]') as HTMLAnchorElement | null;
    const whatsapp = root.querySelector('[data-share="whatsapp"]') as HTMLAnchorElement | null;

    if (x) {
      x.href = `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`;
    }

    if (facebook) {
      facebook.href = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
    }

    if (linkedin) {
      linkedin.href = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
    }

    if (whatsapp) {
      whatsapp.href = `https://wa.me/?text=${encodedText}`;
    }

    trigger.addEventListener('click', () => {
      const isOpen = !panel.hidden;
      panel.hidden = isOpen;
      trigger.setAttribute('aria-expanded', String(!isOpen));
    });

    root.querySelector('[data-share="copy"]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLButtonElement;

      try {
        await navigator.clipboard.writeText(url);
        const original = button.textContent;
        button.textContent = 'Copied!';
        setTimeout(() => {
          button.textContent = original || 'Copy link';
        }, 1800);
      } catch {
        window.prompt('Copy this link:', url);
      }
    });

    root.querySelector('[data-share="native"]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLButtonElement;

      if (!navigator.share) {
        await navigator.clipboard.writeText(url);
        button.textContent = 'Copied!';
        setTimeout(() => {
          button.textContent = 'Share';
        }, 1800);
        return;
      }

      try {
        await navigator.share({
          title,
          text: description || title,
          url,
        });
      } catch {}
    });

    root.querySelector('[data-share="instagram"]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLButtonElement;

      try {
        if (navigator.share) {
          await navigator.share({
            title,
            text: description || title,
            url,
          });
          return;
        }

        await navigator.clipboard.writeText(url);
        window.open('https://www.instagram.com/', '_blank', 'noopener,noreferrer');

        button.textContent = 'Link copied!';
        setTimeout(() => {
          button.textContent = 'Instagram';
        }, 1800);
      } catch {}
    });

    document.addEventListener('click', (event) => {
      if (!root.contains(event.target as Node)) {
        panel.hidden = true;
        trigger.setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>

<style>
  .share-wrap {
    position: relative;
    display: inline-block;
  }

  .share-trigger {
    border: 1px solid var(--line, #ddd);
    background: transparent;
    padding: 0.55rem 0.9rem;
    font: inherit;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .share-trigger:hover {
    opacity: 0.65;
  }

  .share-panel {
    position: absolute;
    z-index: 30;
    top: calc(100% + 0.65rem);
    right: 0;
    width: min(23rem, calc(100vw - 2rem));
    padding: 1rem;
    border: 1px solid var(--line, #ddd);
    background: var(--bg, #f5f3f0);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.12);
  }

  .share-preview {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 0.8rem;
    align-items: start;
    margin-bottom: 1rem;
  }

  .share-preview img {
    width: 4.5rem;
    height: 4.5rem;
    object-fit: cover;
  }

  .share-preview strong {
    display: block;
    font-size: 0.9rem;
    line-height: 1.3;
  }

  .share-preview p {
    margin: 0.3rem 0 0;
    font-size: 0.75rem;
    line-height: 1.4;
    opacity: 0.65;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .share-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .share-btn {
    border: 1px solid var(--line, #ddd);
    background: transparent;
    color: inherit;
    padding: 0.45rem 0.65rem;
    font: inherit;
    font-size: 0.75rem;
    text-decoration: none;
    cursor: pointer;
  }

  .share-btn:hover {
    opacity: 0.65;
  }

  .share-compact .share-panel {
    right: auto;
    left: 0;
  }
</style>
