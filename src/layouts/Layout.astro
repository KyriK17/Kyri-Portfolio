---
/**
 * The page shell used by every page: <head>, header, footer and fonts.
 */
import '@fontsource-variable/newsreader';
import '@fontsource-variable/instrument-sans';
import '../styles/global.css';
import '../styles/editorial.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const { title, description, image, type, publishedTime, noindex, jsonLd } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080808" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      publishedTime={publishedTime}
      noindex={noindex}
    />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      // Fade every image in once it is ready. The short delay means the fade is always seen,
      // even when the image comes straight from the cache.
      const reveal = (img: HTMLImageElement) => {
        if (img.classList.contains('is-loaded')) return;
        const show = () => requestAnimationFrame(() => requestAnimationFrame(() => img.classList.add('is-loaded')));
        if (img.complete && img.naturalWidth > 0) {
          img.decode ? img.decode().then(show, show) : show();
        } else {
          img.addEventListener('load', show, { once: true });
          img.addEventListener('error', show, { once: true });
        }
      };
      document.querySelectorAll<HTMLImageElement>('img[data-reveal]').forEach(reveal);
      // Scroll reveal: blocks below the fold rise in as they arrive, in a short stagger.
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const groups = new Map<Element, number>();
        const targets = document.querySelectorAll<HTMLElement>(
          '.card, .timeline-item, .section-head-row, .filter-row, .email-link, .byline, .chips, .site-footer .wrap > *',
        );
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        targets.forEach((el) => {
          if (el.getBoundingClientRect().top < innerHeight) return; // already on screen: leave alone
          const parent = el.parentElement as Element;
          const n = groups.get(parent) ?? 0;
          groups.set(parent, n + 1);
          el.style.setProperty('--d', `${Math.min(n, 5) * 90}ms`);
          el.setAttribute('data-rise', '');
          io.observe(el);
        });
      }
      // Safety net: never leave an image hidden.
      setTimeout(() => document.querySelectorAll('img[data-reveal]:not(.is-loaded)').forEach((i) => {
        if ((i as HTMLImageElement).complete) i.classList.add('is-loaded');
      }), 4000);
    </script>
  </body>
</html>
